{
  "name": "@agentdesk/desktop",
  "version": "2.2.0-beta.1",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:electron --outfile=dist/main.mjs && esbuild src/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/preload.cjs"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "license": "MIT",
  "description": "Runember desktop client",
  "author": "Runember contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kasol/Runember.git"
  }
}
