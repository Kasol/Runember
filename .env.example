# Runember 可选配置，无代理、钉钉或隔离需求时无需创建 .env。
# 完整说明见 docs/configuration.md。不要提交个人 .env 或密钥。
# AGENTDESK_DATA_DIR=D:/Runember/data
# AGENTDESK_LOG_DIR=D:/Runember/logs
# AGENTDESK_PORT=8787
# AGENTDESK_SCHEDULER__CONCURRENCY=1
# AGENTDESK_SCHEDULER__TASKTIMEOUTMIN=30

# 宿主代理按实际需要填写，不要在宿主使用 host.docker.internal。
# AGENTDESK_PROXY__NATIVEHTTPSPROXY=http://127.0.0.1:你的代理端口
# AGENTDESK_PROXY__NATIVEHTTPPROXY=http://127.0.0.1:你的代理端口

# CLI 默认自动发现，也可在顶部「环境设置」中选择。
# AGENTDESK_AGENTS__CODEX__EXECUTABLE=C:/你的路径/codex.exe
# AGENTDESK_AGENTS__ZCODE__EXECUTABLE=C:/你的路径/resources/glm/zcode.cjs
# AGENTDESK_AGENTS__DEEPSEEK__EXECUTABLE=C:/你的路径/DeepSeek Harness.exe

# 钉钉报告可选，需要用户自己的文档 CLI 和授权目录。
# AGENTDESK_NOTIFY__DINGTALKREPORT__EXECUTABLE=C:/你的路径/dws.exe
# AGENTDESK_NOTIFY__DINGTALKREPORT__CONFIGDIR=D:/Runember/dws-auth
# AGENTDESK_NOTIFY__DINGTALKREPORT__PROFILE=你的企业ID:你的用户ID
# AGENTDESK_NOTIFY__DINGTALKREPORT__FOLDER=你的文件夹ID

# 仅用于容器探针的可选认证与代理。
# CODEX_API_KEY=
# OPENAI_API_KEY=
# AGENTDESK_PROXY__HTTPSPROXY=http://host.docker.internal:你的代理端口
