{
  "name": "agentdesk",
  "version": "2.2.0-beta.1",
  "private": true,
  "description": "Runember: local Agent task scheduling, diagnostics and session continuity",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "m0": "bash scripts/m0.sh",
    "m0:offline": "bash scripts/m0.sh --offline",
    "m0:login": "bash scripts/m0.sh login",
    "daemon": "tsx apps/daemon/src/index.ts",
    "desk": "tsx apps/cli/src/index.ts",
    "web": "npm run dev -w apps/web",
    "desktop": "npm run build -w @agentdesk/desktop && electron apps/desktop",
    "release:desktop": "node scripts/release-desktop.mjs",
    "release:windows": "node scripts/release-windows.mjs",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "release:runtime": "node scripts/release-runtime.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "test": "node --import tsx --test apps/daemon/test/*.test.ts",
    "ci:build": "node scripts/ci-build.mjs"
  },
  "dependencies": {
    "dockerode": "^4.0.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.35",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "dockerode": {
      "uuid": "11.1.1"
    }
  },
  "license": "MIT",
  "author": "Runember contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kasol/Runember.git"
  }
}
