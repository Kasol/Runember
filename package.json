{
  "name": "agentdesk",
  "version": "2.1.0",
  "private": true,
  "description": "无人值守 Agent 工作台：调度 Codex 等 CLI Agent，阻塞通知到钉钉，反馈后续跑",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "m0": "bash scripts/m0.sh",
    "m0:offline": "bash scripts/m0.sh --offline",
    "m0:login": "bash scripts/m0.sh login",
    "daemon": "tsx apps/daemon/src/index.ts",
    "desk": "tsx apps/cli/src/index.ts",
    "web": "npm run dev -w apps/web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dockerode": "^4.0.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.35",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
